# Generated by Terraform (provider-azure/single-box). Single source of truth for
# capacity tuning. Read by bootstrap.sh and env-overrides.sh. Do not edit by hand
# on the box — change the Terraform variables and re-apply, or edit and re-run
# /opt/e2b/env-overrides.sh then restart the e2b-* services.

SESSIONS=${sessions}
PER_SESSION_VCPU=${per_session_vcpu}
PER_SESSION_RAM_MB=${per_session_ram_mb}

# Kernel / host tuning
NR_HUGEPAGES=${nr_hugepages}
NBDS_MAX=${nbds_max}
SNAPSHOT_CACHE_GB=${snapshot_cache_gb}

# Orchestrator .env.local overrides
NBD_POOL_SIZE=${nbd_pool_size}

# Source
REPO_URL=${repo_url}
REPO_REF=${repo_ref}
ADMIN_USERNAME=${admin_username}
