#cloud-config
package_update: true
packages:
  - docker.io

write_files:
  # E2B's ClickHouse migrations create Distributed('cluster', ...) tables, so
  # even a single node must define a cluster named "cluster".
  - path: /opt/data-node/clickhouse-config.d/cluster.xml
    permissions: '0644'
    content: |
      <clickhouse>
        <remote_servers>
          <cluster>
            <shard>
              <internal_replication>false</internal_replication>
              <replica><host>localhost</host><port>9000</port></replica>
            </shard>
          </cluster>
        </remote_servers>
        <macros><shard>01</shard><replica>01</replica></macros>
      </clickhouse>

  - path: /opt/data-node/start.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      # ClickHouse (analytics) — native 9000 + HTTP 8123
      docker rm -f clickhouse 2>/dev/null || true
      docker run -d --restart=always --name clickhouse \
        -p 9000:9000 -p 8123:8123 \
        -e CLICKHOUSE_USER='${clickhouse_user}' \
        -e CLICKHOUSE_PASSWORD='${clickhouse_password}' \
        -e CLICKHOUSE_DB=default \
        -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 \
        --ulimit nofile=262144:262144 \
        -v /var/lib/clickhouse:/var/lib/clickhouse \
        -v /opt/data-node/clickhouse-config.d/cluster.xml:/etc/clickhouse-server/config.d/cluster.xml:ro \
        clickhouse/clickhouse-server:25.4

      # Redis (cache/pubsub) — no auth; reachable only inside the VNet via NSG.
      # E2B's client connects to REDIS_URL as host:6379 with no password.
      docker rm -f redis 2>/dev/null || true
      docker run -d --restart=always --name redis \
        -p 6379:6379 \
        -v /var/lib/redis:/data \
        redis:7.4 redis-server --appendonly yes

      # PostgreSQL (primary transactional store) — private, in-VNet only.
      # Managed Azure PostgreSQL is offer-restricted here, so we self-host.
      docker rm -f postgres 2>/dev/null || true
      docker run -d --restart=always --name postgres \
        -p 5432:5432 \
        -e POSTGRES_USER='${postgres_user}' \
        -e POSTGRES_PASSWORD='${postgres_password}' \
        -e POSTGRES_DB=postgres \
        -v /var/lib/postgresql-data:/var/lib/postgresql/data \
        postgres:17.4

      # E2B's migrations assume a superuser role named "postgres"; our admin
      # role is '${postgres_user}', so create it if missing.
      for i in $(seq 1 60); do
        docker exec postgres pg_isready -U '${postgres_user}' -d postgres >/dev/null 2>&1 && break
        sleep 2
      done
      docker exec postgres psql -U '${postgres_user}' -d postgres -tAc \
        "SELECT 1 FROM pg_roles WHERE rolname='postgres'" | grep -q 1 || \
        docker exec postgres psql -U '${postgres_user}' -d postgres \
          -c "CREATE ROLE postgres SUPERUSER LOGIN"

runcmd:
  - systemctl enable --now docker
  - /bin/bash /opt/data-node/start.sh
